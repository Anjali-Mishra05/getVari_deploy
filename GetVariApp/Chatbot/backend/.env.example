# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Supabase. The service-role key bypasses row-level security, so it belongs
# only in this server's environment, never in the app.
SUPABASE_URL=https://ntuboicvzsoamwedtprg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The LLM that answers questions, and the embedding/rerank service.
# GROQ_MODEL is optional; it defaults to openai/gpt-oss-120b. Check
# https://console.groq.com/docs/models when a model 404s — Groq retires them.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
JINA_API_KEY=

# Shared secret the app sends as `X-API-Key`. Required for any deployment
# reachable from the internet; may be left unset on a laptop.
AQUASAGE_API_KEY=

# Comma-separated browser origins, or * . Native apps ignore this.
ALLOWED_ORIGINS=*
